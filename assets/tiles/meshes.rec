# meshes.rec: the armour pieces the inventory hero can wear as cube meshes, built by tools/convertarmor.py
# from the Epic Knights models (MIT). gear.rec maps an armour to them (helmet/chest/leggings/boots: an id here).

%rec: mesh
%doc: Armour meshes

id: armet
name: armet
piece: helmet
geo: ../knight/meshes/armet.json
tex: ../knight/armor/armet_layer_1.png

id: knight_chestplate
name: knight chestplate
piece: chest
geo: ../knight/meshes/default_chest.json
